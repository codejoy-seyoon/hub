# 스토어 전용 배포(store.bnikorea.com)용 설정 — 비밀값 아님, 저장소에 올려도 된다.
# 빈 값이면 주소에서 "/store" 를 뗀다. 로컬 개발(npm run dev)에는 적용되지 않는다.
NEXT_PUBLIC_STORE_BASE=

# 주문 DB: Supabase 프로젝트 「bni pay」(hq@bnikorea.net) 안의 store 방.
# 아래 두 값은 공개용이다(브라우저에 실려 나가도 되는 주소와 공개 키). 공개 키만으로는 store 방을 볼 수 없다.
# 서버용 증표 SUPABASE_STORE_JWT 는 여기 두지 않고 Cloudflare 비밀값으로만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=https://haznndgtspkxhxlnsqxk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_F66XJD1gUm6pLwekQNyV5g_aADp_2LJ
